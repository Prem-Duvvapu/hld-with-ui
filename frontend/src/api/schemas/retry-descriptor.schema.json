{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "modelVersion",
    "description",
    "limits",
    "presets",
    "assumptions"
  ],
  "properties": {
    "id": { "type": "string", "const": "timeouts-retries" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "kind": { "type": "string", "const": "simulation" },
    "modelVersion": { "type": "string", "const": "1.0.0" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "limits": { "$ref": "#/$defs/RetryLimits" },
    "presets": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/RetryPreset" }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "$defs": {
    "RetryIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "not": { "pattern": "\\s" }
    },
    "RetryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "arrivalTimeMs", "serviceTimeMs"],
      "properties": {
        "id": { "$ref": "#/$defs/RetryIdentifier" },
        "arrivalTimeMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "serviceTimeMs": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "RetryInput": {
      "title": "Timeouts and retries model input",
      "description": "Canonical finite input for an illustrative caller retry policy and shared dependency worker queue. Java additionally validates unique original IDs, chronological arrival order and maxDelayMs >= baseDelayMs before any transition. Parsed JSON shape is not transport token spelling, duplicate-key or trailing-root validation. One run-local recorded random stream selects bounded FULL jitter delays; no network, cancellation, business effect, database or durability is modeled.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "modelVersion",
        "seed",
        "workers",
        "queueCapacity",
        "attemptTimeoutMs",
        "overallTimeoutMs",
        "maxAttempts",
        "backoff",
        "baseDelayMs",
        "maxDelayMs",
        "jitter",
        "retryBudget",
        "unavailableUntilMs",
        "requests"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "modelVersion": { "const": "1.0.0" },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "workers": { "type": "integer", "minimum": 1, "maximum": 3 },
        "queueCapacity": { "type": "integer", "minimum": 0, "maximum": 12 },
        "attemptTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "overallTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "backoff": { "enum": ["IMMEDIATE", "EXPONENTIAL"] },
        "baseDelayMs": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "maxDelayMs": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "jitter": { "enum": ["NONE", "FULL"] },
        "retryBudget": { "type": "integer", "minimum": 0, "maximum": 48 },
        "unavailableUntilMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "requests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/RetryRequest" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "backoff": { "const": "IMMEDIATE" } },
            "required": ["backoff"],
            "type": "object"
          },
          "then": {
            "properties": {
              "baseDelayMs": { "const": 0 },
              "maxDelayMs": { "const": 0 },
              "jitter": { "const": "NONE" }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": { "backoff": { "const": "EXPONENTIAL" } },
            "required": ["backoff"],
            "type": "object"
          },
          "then": {
            "properties": {
              "baseDelayMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "maxDelayMs": { "type": "integer", "minimum": 1, "maximum": 1000 }
            },
            "type": "object"
          }
        }
      ]
    },
    "RetryLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSafeSeed",
        "maxWorkers",
        "maxQueueCapacity",
        "maxRequests",
        "maxArrivalTimeMs",
        "maxServiceTimeMs",
        "maxAttemptTimeoutMs",
        "maxOverallTimeoutMs",
        "maxAttempts",
        "maxDelayMs",
        "maxRetryBudget",
        "maxUnavailableUntilMs",
        "maxIdLength"
      ],
      "properties": {
        "maxSafeSeed": { "type": "integer", "const": 9007199254740991 },
        "maxWorkers": { "type": "integer", "const": 3 },
        "maxQueueCapacity": { "type": "integer", "const": 12 },
        "maxRequests": { "type": "integer", "const": 12 },
        "maxArrivalTimeMs": { "type": "integer", "const": 10000 },
        "maxServiceTimeMs": { "type": "integer", "const": 1000 },
        "maxAttemptTimeoutMs": { "type": "integer", "const": 1000 },
        "maxOverallTimeoutMs": { "type": "integer", "const": 10000 },
        "maxAttempts": { "type": "integer", "const": 5 },
        "maxDelayMs": { "type": "integer", "const": 1000 },
        "maxRetryBudget": { "type": "integer", "const": 48 },
        "maxUnavailableUntilMs": { "type": "integer", "const": 10000 },
        "maxIdLength": { "type": "integer", "const": 32 }
      }
    },
    "RetryPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "input"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "not": { "pattern": "\\s" }
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 600 },
        "input": { "$ref": "#/$defs/RetryInput" }
      }
    }
  }
}
