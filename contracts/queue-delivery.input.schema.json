{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/queue-delivery.input.schema.json",
  "title": "Queue delivery domain input",
  "description": "Standalone input for the illustrative queues-delivery domain model, schema 1.0/model 1.0.0. No HTTP route, catalog capability or renderer is registered by this contract. Arrays retain authored input order. Java additionally validates unique message/consumer IDs, referenced fault identities, unique loss selectors, alternating chronological failure schedules and ACK-before delay strictly less than processing time. JSON Schema validates parsed JSON values, not token spellings or duplicate JSON keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersion",
    "messages",
    "consumers",
    "processingTimeMs",
    "acknowledgmentDelayMs",
    "visibilityTimeoutMs",
    "maxDeliveryAttempts",
    "acknowledgmentPolicy",
    "failures",
    "lostAcknowledgments",
    "seed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enqueueTimeMs"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "not": {
              "pattern": "\\s"
            }
          },
          "enqueueTimeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "not": {
              "pattern": "\\s"
            }
          }
        }
      }
    },
    "processingTimeMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "acknowledgmentDelayMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "visibilityTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "maxDeliveryAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "acknowledgmentPolicy": {
      "enum": ["ACK_BEFORE_EFFECT", "ACK_AFTER_EFFECT"]
    },
    "failures": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumerId", "action", "timeMs"],
        "properties": {
          "consumerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "not": {
              "pattern": "\\s"
            }
          },
          "action": {
            "enum": ["CRASH", "RECOVER"]
          },
          "timeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        }
      }
    },
    "lostAcknowledgments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messageId", "attempt"],
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "not": {
              "pattern": "\\s"
            }
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  }
}
