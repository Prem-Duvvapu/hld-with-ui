{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/timeouts-retries.input.schema.json",
  "title": "Timeouts and retries model input",
  "description": "Canonical finite input for an illustrative caller retry policy and shared dependency worker queue. Java additionally validates unique original IDs, chronological arrival order and maxDelayMs >= baseDelayMs before any transition. Parsed JSON shape is not transport token spelling, duplicate-key or trailing-root validation. One run-local recorded random stream selects bounded FULL jitter delays; no network, cancellation, business effect, database or durability is modeled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersion",
    "seed",
    "workers",
    "queueCapacity",
    "attemptTimeoutMs",
    "overallTimeoutMs",
    "maxAttempts",
    "backoff",
    "baseDelayMs",
    "maxDelayMs",
    "jitter",
    "retryBudget",
    "unavailableUntilMs",
    "requests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "queueCapacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "attemptTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "overallTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "backoff": {
      "enum": ["IMMEDIATE", "EXPONENTIAL"]
    },
    "baseDelayMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "maxDelayMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "jitter": {
      "enum": ["NONE", "FULL"]
    },
    "retryBudget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 48
    },
    "unavailableUntilMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/request"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "backoff": {
            "const": "IMMEDIATE"
          }
        },
        "required": ["backoff"],
        "type": "object"
      },
      "then": {
        "properties": {
          "baseDelayMs": {
            "const": 0
          },
          "maxDelayMs": {
            "const": 0
          },
          "jitter": {
            "const": "NONE"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "backoff": {
            "const": "EXPONENTIAL"
          }
        },
        "required": ["backoff"],
        "type": "object"
      },
      "then": {
        "properties": {
          "baseDelayMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "maxDelayMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "type": "object"
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "arrivalTimeMs", "serviceTimeMs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "arrivalTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "serviceTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
