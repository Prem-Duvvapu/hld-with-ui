{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/checkpoints.schema.json",
  "title": "Guided simulation checkpoints",
  "description": "Guided simulation checkpoints with model-specific semantic targets. Java tests execute every named preset and reconcile the event, snapshot and authored numerical facts.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "simulationId",
      "presetId",
      "target",
      "prompt",
      "lookFor",
      "explanation",
      "tradeoff"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 3,
        "maxLength": 60
      },
      "simulationId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "presetId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "target": {
        "description": "Select exactly one semantic subject: a cache operation or a queue job ID, plus event kind and 1-based occurrence.",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "kind", "occurrence"],
            "properties": {
              "operation": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z]+$"
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["jobId", "kind", "occurrence"],
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9-]{0,31}$",
                "not": {
                  "pattern": "\\s"
                }
              },
              "kind": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z]+$"
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      },
      "prompt": {
        "type": "string",
        "minLength": 20
      },
      "lookFor": {
        "type": "string",
        "minLength": 20
      },
      "explanation": {
        "type": "string",
        "minLength": 40
      },
      "tradeoff": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "options", "recommendedOptionId"],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 20
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "feedback"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 3
                },
                "feedback": {
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          },
          "recommendedOptionId": {
            "type": "string"
          }
        }
      }
    },
    "description": "One predict -> reveal -> explain -> choose step. Its target selects a supported event in the real preset trace by stable operation or job identity, kind and occurrence."
  }
}
