{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/checkpoints.schema.json",
  "title": "Guided simulation checkpoints",
  "description": "Predict -> reveal -> explain -> choose steps. Each target names one event in the trace of a Java preset by operation, event kind, and occurrence; never by array index or narration. Java tests resolve every target against the real trace.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "simulationId",
      "presetId",
      "target",
      "prompt",
      "lookFor",
      "explanation",
      "tradeoff"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 3, "maxLength": 60 },
      "simulationId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "presetId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "target": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "kind", "occurrence"],
        "properties": {
          "operation": { "type": "integer", "minimum": 1 },
          "kind": { "type": "string", "pattern": "^[a-z]+\\.[a-z]+$" },
          "occurrence": { "type": "integer", "minimum": 1 }
        }
      },
      "prompt": { "type": "string", "minLength": 20 },
      "lookFor": { "type": "string", "minLength": 20 },
      "explanation": { "type": "string", "minLength": 40 },
      "tradeoff": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "options", "recommendedOptionId"],
        "properties": {
          "prompt": { "type": "string", "minLength": 20 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "feedback"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": { "type": "string", "minLength": 3 },
                "feedback": { "type": "string", "minLength": 20 }
              }
            }
          },
          "recommendedOptionId": { "type": "string" }
        }
      }
    }
  }
}
