    "minCalls": 1,
    "maxCalls": 12,
    "minSteps": 2,
    "maxSteps": 48,
    "maxUnits": 1000,
    "maxRetentionMs": 10000,
    "maxTimeMs": 10000,
    "maxIdLength": 32,
    "maxDerivedIdLength": 39,
    "maxExpiresAtMs": 20000,
    "maxPublishedUnits": 12000
  },
