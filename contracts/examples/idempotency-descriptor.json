{
  "id": "idempotency",
  "title": "Idempotency",
  "kind": "simulation",
  "schemaVersion": "1.0",
  "modelVersion": "1.0.0",
  "description": "Compare lost responses, split writes and atomic effect/result publication. Inspect private work, public effects, retained keys and caller observations in a bounded authored program without real storage or durability guarantees.",
  "defaultPresetId": "unprotected-response-loss",
