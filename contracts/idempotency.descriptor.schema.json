{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/idempotency.descriptor.schema.json",
  "title": "Idempotency model descriptor",
  "description": "Closed metadata for the bounded original Java idempotency model. Preset references and input identities are checked separately; Java owns valid program execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "schemaVersion",
    "modelVersion",
    "description",
    "defaultPresetId",
    "limits",
    "presets",
    "assumptions"
  ],
  "properties": {
    "id": {
      "const": "idempotency"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "kind": {
      "const": "simulation"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "defaultPresetId": {
      "const": "unprotected-response-loss"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "presets": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/preset"
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minCalls",
        "maxCalls",
        "minSteps",
        "maxSteps",
        "maxUnits",
        "maxRetentionMs",
        "maxTimeMs",
        "maxIdLength",
        "maxDerivedIdLength",
        "maxExpiresAtMs",
        "maxPublishedUnits"
      ],
      "properties": {
        "minCalls": {
          "type": "integer",
          "const": 1
        },
        "maxCalls": {
          "type": "integer",
          "const": 12
        },
        "minSteps": {
          "type": "integer",
          "const": 2
        },
        "maxSteps": {
          "type": "integer",
          "const": 48
        },
        "maxUnits": {
          "type": "integer",
          "const": 1000
        },
        "maxRetentionMs": {
          "type": "integer",
          "const": 10000
        },
        "maxTimeMs": {
          "type": "integer",
          "const": 10000
        },
        "maxIdLength": {
          "type": "integer",
          "const": 32
        },
        "maxDerivedIdLength": {
          "type": "integer",
          "const": 39
        },
        "maxExpiresAtMs": {
          "type": "integer",
          "const": 20000
        },
        "maxPublishedUnits": {
          "type": "integer",
          "const": 12000
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "question", "input"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "unprotected-response-loss",
            "split-crash-gap",
            "split-race",
            "atomic-response-loss",
            "atomic-race",
            "payload-conflict",
            "atomic-payload-race",
            "retention-boundary",
            "key-and-tenant-scope"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "input": {
          "$ref": "https://hld-with-ui.dev/schemas/idempotency.input.schema.json"
        }
      }
    }
  }
}
