{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/transactions-isolation.result.schema.json",
  "title": "Reservation interleaving model result",
  "description": "Complete authoritative untimed reservation analysis. Captured input and all identities reference the canonical input owner. Closed outcome kinds distinguish reads, accepted reservations and business rejections; post-state retains prior observations. Completed describes schedule consumption, not invariant preservation or database commit. Unsafe allocated/accounted bounds intentionally permit values above initial units. Java tests own identity correlation, snapshot equality, arithmetic and first violating prefix semantics; JSON Schema establishes structure and local required/forbidden fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "simulationId",
    "schemaVersion",
    "modelVersion",
    "kind",
    "status",
    "input",
    "initialState",
    "outcomes",
    "finalState",
    "metrics",
    "assumptions"
  ],
  "properties": {
    "simulationId": {
      "const": "transactions-isolation"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "analysis"
    },
    "status": {
      "const": "completed"
    },
    "input": {
      "$ref": "https://hld-with-ui.dev/schemas/transactions-isolation.input.schema.json"
    },
    "initialState": {
      "allOf": [
        {
          "$ref": "#/$defs/state"
        },
        {
          "type": "object",
          "properties": {
            "allocatedUnits": {
              "const": 0
            },
            "allocations": {
              "type": "array",
              "maxItems": 0
            },
            "reservations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "NOT_READ"
                  }
                }
              }
            },
            "invariants": {
              "type": "object",
              "properties": {
                "remainingNonnegative": {
                  "const": true
                },
                "allocatedWithinCapacity": {
                  "const": true
                },
                "unitsConserved": {
                  "const": true
                },
                "accountedUnits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            }
          }
        }
      ]
    },
    "outcomes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "finalState": {
      "allOf": [
        {
          "$ref": "#/$defs/state"
        },
        {
          "type": "object",
          "properties": {
            "reservations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": ["ACCEPTED", "REJECTED"]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    }
  },
  "$defs": {
    "reservationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quantity", "status"],
      "properties": {
        "id": {
          "$ref": "https://hld-with-ui.dev/schemas/transactions-isolation.input.schema.json#/$defs/identifier"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "status": {
          "enum": ["NOT_READ", "READ_OBSERVED", "ACCEPTED", "REJECTED"]
        },
        "observedRemaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_READ"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["observedRemaining"]
                }
              ]
            }
          },
          "else": {
            "required": ["observedRemaining"]
          }
        }
      ]
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservationId", "quantity", "stepId"],
      "properties": {
        "reservationId": {
          "$ref": "https://hld-with-ui.dev/schemas/transactions-isolation.input.schema.json#/$defs/identifier"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "stepId": {
          "$ref": "https://hld-with-ui.dev/schemas/transactions-isolation.input.schema.json#/$defs/identifier"
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remainingNonnegative",
        "allocatedWithinCapacity",
        "unitsConserved",
        "accountedUnits"
      ],
      "properties": {
        "remainingNonnegative": {
          "type": "boolean"
        },
        "allocatedWithinCapacity": {
          "type": "boolean"
        },
        "unitsConserved": {
          "type": "boolean"
        },
        "accountedUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remainingUnits",
        "allocatedUnits",
        "reservations",
        "allocations",
        "invariants"
      ],
      "properties": {
        "remainingUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "allocatedUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "reservations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/reservationState"
          }
        },
        "allocations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/allocation"
          }
        },
        "invariants": {
          "$ref": "#/$defs/invariants"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "stepId",
        "reservationId",
        "action",
        "kind",
        "postState",
        "explanation"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "stepId": {
          "$ref": "https://hld-with-ui.dev/schemas/transactions-isolation.input.schema.json#/$defs/identifier"
        },
        "reservationId": {
          "$ref": "https://hld-with-ui.dev/schemas/transactions-isolation.input.schema.json#/$defs/identifier"
        },
        "action": {
          "enum": ["READ", "ATTEMPT_RESERVE"]
        },
        "kind": {
          "enum": [
            "READ_OBSERVED",
            "RESERVATION_ACCEPTED",
            "RESERVATION_REJECTED"
          ]
        },
        "postState": {
          "$ref": "#/$defs/state"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "observedRemaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "checkedRemaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "checkSource": {
          "enum": ["SNAPSHOT", "CURRENT"]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "rejectionReason": {
          "const": "INSUFFICIENT_STOCK"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "READ_OBSERVED"
              }
            }
          },
          "then": {
            "required": ["observedRemaining"],
            "properties": {
              "action": {
                "const": "READ"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["checkedRemaining"]
                },
                {
                  "required": ["checkSource"]
                },
                {
                  "required": ["quantity"]
                },
                {
                  "required": ["rejectionReason"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "RESERVATION_ACCEPTED"
              }
            }
          },
          "then": {
            "required": ["checkedRemaining", "checkSource", "quantity"],
            "properties": {
              "action": {
                "const": "ATTEMPT_RESERVE"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["observedRemaining"]
                },
                {
                  "required": ["rejectionReason"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "RESERVATION_REJECTED"
              }
            }
          },
          "then": {
            "required": [
              "checkedRemaining",
              "checkSource",
              "quantity",
              "rejectionReason"
            ],
            "properties": {
              "action": {
                "const": "ATTEMPT_RESERVE"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["observedRemaining"]
                }
              ]
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedReservations",
        "rejectedReservations",
        "finalRemainingUnits",
        "finalAllocatedUnits",
        "invariantStatus"
      ],
      "properties": {
        "acceptedReservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "rejectedReservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "finalRemainingUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "finalAllocatedUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "invariantStatus": {
          "enum": ["PRESERVED", "VIOLATED"]
        },
        "firstViolationStepId": {
          "$ref": "https://hld-with-ui.dev/schemas/transactions-isolation.input.schema.json#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "invariantStatus": {
                "const": "VIOLATED"
              }
            }
          },
          "then": {
            "required": ["firstViolationStepId"]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["firstViolationStepId"]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
