{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/data-access.input.schema.json",
  "title": "Data access analysis input",
  "description": "Canonical finite sequential access-path model. createdOrder is an ordering key, not time. Java additionally checks unique row/operation identities, enabled tenant-scoped business-key uniqueness and inclusive range order. JSON Schema validates parsed values; HTTP additionally rejects duplicate keys, trailing roots and coerced/nonintegral token spellings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersion",
    "indexOrder",
    "enforceBusinessKey",
    "rows",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "indexOrder": {
      "enum": ["NONE", "TENANT_CREATED", "CREATED_TENANT"]
    },
    "enforceBusinessKey": {
      "type": "boolean"
    },
    "rows": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenant", "businessKey", "createdOrder"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "tenant": {
          "$ref": "#/$defs/identifier"
        },
        "businessKey": {
          "$ref": "#/$defs/identifier"
        },
        "createdOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "rowId"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "LOOKUP_ID"
            },
            "rowId": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "tenant",
            "fromCreatedOrder",
            "toCreatedOrder",
            "limit"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "TENANT_RANGE"
            },
            "tenant": {
              "$ref": "#/$defs/identifier"
            },
            "fromCreatedOrder": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "toCreatedOrder": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "fromCreatedOrder",
            "toCreatedOrder",
            "limit"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "ALL_RANGE"
            },
            "fromCreatedOrder": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "toCreatedOrder": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "row"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "INSERT"
            },
            "row": {
              "$ref": "#/$defs/row"
            }
          }
        }
      ]
    }
  }
}
