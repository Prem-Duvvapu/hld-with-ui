{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "id",
      "title",
      "summary",
      "steps",
      "optionalModuleIds"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1,
        "type": "integer"
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 100
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "\\S"
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["moduleId", "purpose"],
          "properties": {
            "moduleId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 100
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        },
        "maxItems": 12,
        "minItems": 1
      },
      "optionalModuleIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "maxItems": 8,
        "minItems": 0,
        "uniqueItems": true
      }
    }
  },
  "maxItems": 8,
  "minItems": 1
}
