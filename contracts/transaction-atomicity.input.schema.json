{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/transaction-atomicity.input.schema.json",
  "title": "Transaction atomicity model input",
  "description": "Canonical finite complete interleaving for illustrative split writes and staged revision-checked publication. Java validates unique transaction/step IDs, references and the four legal complete per-actor programs before execution. Aborting or encountering insufficient stock in a legal program is a modeled result, not malformed input. JSON Schema validates parsed shape and bounds, not protocol order, duplicate JSON keys or integer token spelling. No clock, database or random choices are modeled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersion",
    "mode",
    "initialUnits",
    "transactions",
    "schedule"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": ["SPLIT_WRITES", "STAGED_VERSION_CHECK"]
    },
    "initialUnits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/transaction"
      }
    },
    "schedule": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quantity"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transactionId", "action"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "transactionId": {
          "$ref": "#/$defs/identifier"
        },
        "action": {
          "enum": [
            "BEGIN",
            "DECREMENT_STOCK",
            "RECORD_ALLOCATION",
            "COMMIT",
            "ABORT"
          ]
        }
      }
    }
  }
}
