{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/queue-capacity.input.schema.json",
  "title": "Queue capacity simulation input",
  "description": "Input for the illustrative queues-tail-latency model. Java additionally validates nondecreasing arrivals and unique job IDs. Topic publication is independent of model registration. The HTTP API requires integral JSON tokens and rejects duplicate keys and trailing JSON values; JSON Schema validates the parsed value rather than token spelling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersion",
    "workers",
    "queueCapacity",
    "jobs",
    "seed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "queueCapacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "arrivalTimeMs", "serviceTimeMs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "not": {
              "pattern": "\\s"
            }
          },
          "arrivalTimeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "serviceTimeMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  }
}
