{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/queue-capacity.input.schema.json",
  "title": "Unpublished queue capacity model input",
  "description": "Pure Java queues-tail-latency model only; no registered HTTP endpoint. Java also validates nondecreasing arrival order and unique job IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersion",
    "workers",
    "queueCapacity",
    "jobs",
    "seed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "queueCapacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "arrivalTimeMs", "serviceTimeMs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "arrivalTimeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "serviceTimeMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  }
}
