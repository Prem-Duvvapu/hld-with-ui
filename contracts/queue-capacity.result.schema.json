{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/queue-capacity.result.schema.json",
  "title": "Queue capacity simulation result",
  "description": "Authoritative typed post-event state for the illustrative worker-queue model. Nullable unavailable values may be omitted by the application mapper. Publication status belongs to the topic catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "simulationId",
    "modelVersion",
    "seed",
    "status",
    "lastVirtualTimeMs",
    "assumptions",
    "initialState",
    "events",
    "finalState",
    "outcomes",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "simulationId": {
      "const": "queues-tail-latency"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": ["completed", "limited"]
    },
    "truncationReason": {
      "anyOf": [
        {
          "enum": [
            "event_limit",
            "trace_size_limit",
            "virtual_time_limit",
            "wall_time_limit"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "lastVirtualTimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1060000
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "initialState": {
      "$ref": "#/$defs/state"
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "finalState": {
      "$ref": "#/$defs/state"
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "truncationReason": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": ["truncationReason"],
        "properties": {
          "truncationReason": {
            "enum": [
              "event_limit",
              "trace_size_limit",
              "virtual_time_limit",
              "wall_time_limit"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queuedJobIds", "workers"],
      "properties": {
        "queuedJobIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "not": {
              "pattern": "\\s"
            }
          }
        },
        "workers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^worker-[1-8]$",
                "not": {
                  "pattern": "\\s"
                }
              },
              "jobId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$",
                    "not": {
                      "pattern": "\\s"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "startedAtMs": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1060000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scheduledCompletionAtMs": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1060000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "required": ["jobId"],
                  "properties": {
                    "jobId": {
                      "type": "string"
                    }
                  }
                },
                "then": {
                  "required": ["startedAtMs", "scheduledCompletionAtMs"],
                  "properties": {
                    "startedAtMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1060000
                    },
                    "scheduledCompletionAtMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1060000
                    }
                  }
                },
                "else": {
                  "properties": {
                    "startedAtMs": {
                      "type": "null"
                    },
                    "scheduledCompletionAtMs": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "timeMs", "kind", "jobId", "message", "state"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "timeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1060000
        },
        "kind": {
          "enum": ["job.queued", "job.started", "job.completed", "job.rejected"]
        },
        "jobId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "not": {
            "pattern": "\\s"
          }
        },
        "workerId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^worker-[1-8]$",
              "not": {
                "pattern": "\\s"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 128
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["job.started", "job.completed"]
              }
            }
          },
          "then": {
            "required": ["workerId"],
            "properties": {
              "workerId": {
                "type": "string",
                "pattern": "^worker-[1-8]$",
                "not": {
                  "pattern": "\\s"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["job.queued", "job.rejected"]
              }
            }
          },
          "then": {
            "properties": {
              "workerId": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "status", "arrivalTimeMs", "serviceTimeMs"],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "not": {
            "pattern": "\\s"
          }
        },
        "status": {
          "enum": ["NOT_ARRIVED", "QUEUED", "RUNNING", "COMPLETED", "REJECTED"]
        },
        "arrivalTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "serviceTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "workerId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^worker-[1-8]$",
              "not": {
                "pattern": "\\s"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "startTimeMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1060000
            },
            {
              "type": "null"
            }
          ]
        },
        "terminalTimeMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1060000
            },
            {
              "type": "null"
            }
          ]
        },
        "waitTimeMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1060000
            },
            {
              "type": "null"
            }
          ]
        },
        "latencyMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1060000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "workerId": {
                "type": "string",
                "pattern": "^worker-[1-8]$",
                "not": {
                  "pattern": "\\s"
                }
              },
              "startTimeMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1060000
              },
              "terminalTimeMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1060000
              },
              "waitTimeMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1060000
              },
              "latencyMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1060000
              }
            },
            "required": [
              "workerId",
              "startTimeMs",
              "terminalTimeMs",
              "waitTimeMs",
              "latencyMs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "RUNNING"
              }
            }
          },
          "then": {
            "properties": {
              "workerId": {
                "type": "string",
                "pattern": "^worker-[1-8]$",
                "not": {
                  "pattern": "\\s"
                }
              },
              "startTimeMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1060000
              },
              "terminalTimeMs": {
                "type": "null"
              },
              "waitTimeMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1060000
              },
              "latencyMs": {
                "type": "null"
              }
            },
            "required": ["workerId", "startTimeMs", "waitTimeMs"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REJECTED"
              }
            }
          },
          "then": {
            "properties": {
              "workerId": {
                "type": "null"
              },
              "startTimeMs": {
                "type": "null"
              },
              "terminalTimeMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1060000
              },
              "waitTimeMs": {
                "type": "null"
              },
              "latencyMs": {
                "type": "null"
              }
            },
            "required": ["terminalTimeMs"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "QUEUED"
              }
            }
          },
          "then": {
            "properties": {
              "workerId": {
                "type": "null"
              },
              "startTimeMs": {
                "type": "null"
              },
              "terminalTimeMs": {
                "type": "null"
              },
              "waitTimeMs": {
                "type": "null"
              },
              "latencyMs": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_ARRIVED"
              }
            }
          },
          "then": {
            "properties": {
              "workerId": {
                "type": "null"
              },
              "startTimeMs": {
                "type": "null"
              },
              "terminalTimeMs": {
                "type": "null"
              },
              "waitTimeMs": {
                "type": "null"
              },
              "latencyMs": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalJobs",
        "completed",
        "rejected",
        "queued",
        "running",
        "notArrived",
        "successfulSamples",
        "peakWaiting",
        "observationStartMs",
        "observationEndMs"
      ],
      "properties": {
        "totalJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "notArrived": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "successfulSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "peakWaiting": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "meanSuccessfulWaitMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1060000
            },
            {
              "type": "null"
            }
          ]
        },
        "meanSuccessfulLatencyMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1060000
            },
            {
              "type": "null"
            }
          ]
        },
        "p95SuccessfulWaitMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1060000
            },
            {
              "type": "null"
            }
          ]
        },
        "p95SuccessfulLatencyMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1060000
            },
            {
              "type": "null"
            }
          ]
        },
        "observationStartMs": {
          "const": 0
        },
        "observationEndMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1060000
        },
        "completedThroughputPerSecond": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "successfulSamples": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "meanSuccessfulWaitMs": {
                "type": "null"
              },
              "meanSuccessfulLatencyMs": {
                "type": "null"
              },
              "p95SuccessfulWaitMs": {
                "type": "null"
              },
              "p95SuccessfulLatencyMs": {
                "type": "null"
              }
            }
          },
          "else": {
            "required": [
              "meanSuccessfulWaitMs",
              "meanSuccessfulLatencyMs",
              "p95SuccessfulWaitMs",
              "p95SuccessfulLatencyMs"
            ],
            "properties": {
              "meanSuccessfulWaitMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 1060000
              },
              "meanSuccessfulLatencyMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 1060000
              },
              "p95SuccessfulWaitMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1060000
              },
              "p95SuccessfulLatencyMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1060000
              }
            }
          }
        }
      ]
    }
  }
}
