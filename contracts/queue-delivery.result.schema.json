              "type": "integer",
              "minimum": 0,
              "maximum": 6260000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["ACKNOWLEDGED"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "acknowledgedAtMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6260000
              },
              "ackLatencyMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6260000
              }
            },
            "required": ["acknowledgedAtMs", "ackLatencyMs"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["NOT_ENQUEUED", "READY", "LEASED", "DEAD_LETTERED"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "acknowledgedAtMs": {
                "type": "null"
              },
              "ackLatencyMs": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "committedEffects": {
                "const": 0
              }
            },
            "required": ["committedEffects"]
          },
          "then": {
            "properties": {
              "firstEffectAtMs": {
                "type": "null"
              },
              "firstEffectLatencyMs": {
                "type": "null"
              }
            }
