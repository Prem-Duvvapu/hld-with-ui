        "deliveries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "committedEffects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "acknowledgedAtMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 6260000
            },
            {
              "type": "null"
            }
          ]
        },
        "firstEffectAtMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 6260000
            },
            {
              "type": "null"
            }
          ]
        },
        "ackLatencyMs": {
          "anyOf": [
