    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "status", "deliveries", "committedEffects"],
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "not": {
            "pattern": "\\s"
          }
        },
        "status": {
          "enum": [
            "NOT_ENQUEUED",
            "READY",
            "LEASED",
            "ACKNOWLEDGED",
            "DEAD_LETTERED"
          ]
