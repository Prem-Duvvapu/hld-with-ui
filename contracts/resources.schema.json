{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hld-with-ui.dev/schemas/resources.schema.json",
  "title": "HLD source list",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "organization",
      "url",
      "sourceType",
      "supports",
      "reviewedAt"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 3 },
      "author": { "type": "string", "minLength": 2 },
      "organization": { "type": "string", "minLength": 2 },
      "url": { "type": "string", "format": "uri", "pattern": "^https://" },
      "sourceType": {
        "enum": [
          "documentation",
          "paper",
          "book-chapter",
          "engineering-article",
          "standard",
          "talk"
        ]
      },
      "relevantSections": { "type": "string", "minLength": 3 },
      "supports": { "type": "string", "minLength": 10 },
      "reviewedAt": { "type": "string", "format": "date" },
      "accessStatus": { "enum": ["available", "paywalled", "unavailable"] }
    }
  }
}
